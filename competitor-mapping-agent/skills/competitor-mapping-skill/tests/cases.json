{
  "version": "1.0.0",
  "note": "断言只增不改口径。要让用例变绿，先改包，不许改断言。",
  "cases": [
    {
      "name": "本技能包自检不应有 BLOCKER",
      "kind": "path",
      "path": "..",
      "expect": {"kind": "skill", "blocker": 0, "min_score": 95}
    },
    {
      "name": "配对 Agent 包不应有 BLOCKER",
      "kind": "path",
      "path": "../../competitor-mapping-agent",
      "expect": {"kind": "agent", "blocker": 0, "min_score": 95}
    },
    {
      "name": "反例：缺 frontmatter 与五段的 SKILL.md 应准报编号",
      "kind": "file",
      "file": "fixture-negative-skill.md",
      "expect": {"kind": "skill", "min_blocker": 2, "must": ["SK-02", "SK-04"]}
    },
    {
      "name": "坏 Agent 包应命中平台判据",
      "kind": "tmpagent",
      "expect": {"kind": "agent", "min_blocker": 4}
    },
    {
      "name": "空输入应被拒绝而非给分",
      "kind": "missing",
      "path": "./__not_exist__",
      "expect": {"exit": 2}
    }
  ]
}
